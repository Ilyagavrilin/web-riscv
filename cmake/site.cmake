set(SCR1_MODELS "" CACHE STRING "Prebuilt SCR1 model directories")
set(SCR1_LICENSE "" CACHE FILEPATH "Upstream SCR1 license")

if(NOT SCR1_MODELS OR NOT EXISTS "${SCR1_LICENSE}")
  message(FATAL_ERROR "Provide SCR1_MODELS and SCR1_LICENSE")
endif()

foreach(model IN LISTS SCR1_MODELS)
  file(GLOB artifacts "${model}/scr1-*.mjs" "${model}/scr1-*.wasm")
  foreach(artifact IN LISTS artifacts)
    get_filename_component(name "${artifact}" NAME)
    configure_file("${artifact}" "${name}" COPYONLY)
    install(FILES "${PROJECT_BINARY_DIR}/${name}" DESTINATION .)
  endforeach()
endforeach()

include(CTest)
if(BUILD_TESTING)
  find_program(NODE_EXECUTABLE node REQUIRED)
  file(GLOB tests CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/tests/*.test.mjs")
  add_test(NAME workbench COMMAND "${NODE_EXECUTABLE}" --test ${tests})
  set_tests_properties(workbench PROPERTIES ENVIRONMENT "SCR1_MODEL_DIR=${PROJECT_BINARY_DIR}")
endif()

configure_file("${SCR1_LICENSE}" SCR1-LICENSE COPYONLY)
file(WRITE "${PROJECT_BINARY_DIR}/.nojekyll" "")
install(DIRECTORY web/ DESTINATION .)
install(FILES LICENSE "${PROJECT_BINARY_DIR}/SCR1-LICENSE" "${PROJECT_BINARY_DIR}/.nojekyll" DESTINATION .)

set(SCR1_PERIPHERALS "" CACHE PATH "Prebuilt peripheral directory")
if(SCR1_PERIPHERALS)
  file(MAKE_DIRECTORY "${PROJECT_BINARY_DIR}/peripherals")
  file(GLOB modules "${SCR1_PERIPHERALS}/*.wasm")
  foreach(module IN LISTS modules)
    get_filename_component(name "${module}" NAME)
    configure_file("${module}" "peripherals/${name}" COPYONLY)
  endforeach()
  install(DIRECTORY "${SCR1_PERIPHERALS}/" DESTINATION peripherals)
endif()

set(SCR1_TOOLCHAIN_ASSETS "" CACHE PATH "GNU assembler and linker assets")
if(SCR1_TOOLCHAIN_ASSETS)
  file(MAKE_DIRECTORY "${PROJECT_BINARY_DIR}/toolchain")
  file(COPY "${SCR1_TOOLCHAIN_ASSETS}/" DESTINATION "${PROJECT_BINARY_DIR}/toolchain")
  install(DIRECTORY "${SCR1_TOOLCHAIN_ASSETS}/" DESTINATION toolchain)
endif()
