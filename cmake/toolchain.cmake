set(SCR1_BINUTILS "" CACHE PATH "Pinned GNU binutils Wasm assets")
file(READ "${PROJECT_SOURCE_DIR}/toolchain/node-prefix.mjs" prefix)
foreach(tool IN ITEMS as ld)
  file(READ "${SCR1_BINUTILS}/riscv64-linux-gnu-${tool}.js" glue)
  string(REGEX REPLACE "^#![^\n]*\n" "" glue "${glue}")
  file(WRITE "${PROJECT_BINARY_DIR}/${tool}.mjs" "${prefix}\n${glue}\nexport default Module;\n")
  install(FILES "${PROJECT_BINARY_DIR}/${tool}.mjs" DESTINATION .)
endforeach()
install(FILES "${SCR1_BINUTILS}/as-new.wasm" "${SCR1_BINUTILS}/ld-new.wasm" DESTINATION .)
install(FILES toolchain/COPYING DESTINATION .)
file(WRITE "${PROJECT_BINARY_DIR}/SOURCE.txt" "GNU binutils 2.46.0\nSource: https://ftp.gnu.org/gnu/binutils/binutils-2.46.0.tar.xz\nWasm build: https://github.com/racerxdl/riscv-online-asm/tree/0bc309eb8da8c2573e8f122067c52b815f13090c\n")
install(FILES "${PROJECT_BINARY_DIR}/SOURCE.txt" DESTINATION .)
